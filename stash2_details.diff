+class FlashSelfAttentionVarlen(torch.nn.Module):
+    """Flash Attention for variable length sequences (packed sequences).
+    
+    This class handles packed sequences with cu_seqlens for efficient batched processing.
+    Input shape: (total_seq_len, num_heads, head_dim) - already flattened packed sequences
+    """
+    
+    def __init__(self, causal=False, softmax_scale=None, attention_dropout=0.0, device=None, dtype=None):
+        super().__init__()
+        assert flash_attn_unpadded_func is not None, (
+            "Please install FlashAttention first, e.g., with pip install flash-attn"
+        )
+        self.causal = causal
+        self.softmax_scale = softmax_scale
+        self.dropout_p = attention_dropout
+
+    def forward(self, q, k, v, cu_seqlens=None, max_seqlen=None):
+        """
+        Arguments:
+            q, k, v: Tensors of shape (total_seq_len, num_heads, head_dim)
+            cu_seqlens: Cumulative sequence lengths tensor of shape (batch_size + 1,)
+            max_seqlen: Maximum sequence length in the batch
+        """
+        assert all((i.dtype in [torch.float16, torch.bfloat16] for i in (q, k, v)))
+        assert all((i.is_cuda for i in (q, k, v)))
+        assert cu_seqlens is not None and max_seqlen is not None, \
+            "cu_seqlens and max_seqlen must be provided for varlen attention"
+        
+        if self.training:
+            dropout_p = self.dropout_p
+        else:
+            dropout_p = 0
+
+        # Flash attention requires cu_seqlens to be int32
+        cu_seqlens_int32 = cu_seqlens.to(torch.int32)
+        
+        # Ensure q, k, v are 3D: (total_seq, num_heads, head_dim)
+        # Input might be (seq, batch=1, heads, dim), need to squeeze batch dim
+        squeezed = False
+        if q.dim() == 4 and q.size(1) == 1:
+            q, k, v = [x.squeeze(1) for x in [q, k, v]]
+            squeezed = True
+
+        output = flash_attn_unpadded_func(
+            q,
+            k,
+            v,
+            cu_seqlens_int32,
+            cu_seqlens_int32,
+            max_seqlen,
+            max_seqlen,
+            dropout_p,
+            softmax_scale=self.softmax_scale,
+            causal=self.causal,
+        )
+        
+        # Add back the batch dimension if it was squeezed
+        # Output should be (b, s, h, d) format to match rearrange expectation
+        if squeezed:
+            output = output.unsqueeze(0)  # (s, h, d) -> (1, s, h, d) = (b, s, h, d)
+
+        return output
